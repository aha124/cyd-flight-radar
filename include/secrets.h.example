// secrets.h.example
//
// Copy this file to "secrets.h" in this same directory and fill in
// your actual values. secrets.h is gitignored so your credentials
// won't be committed.

#pragma once

// --- WiFi ---
#define WIFI_SSID "YourNetworkName"
#define WIFI_PASSWORD "YourNetworkPassword"

// --- Location (your home coordinates, used for radar centering) ---
// Hershey, PA defaults below. Override with your actual location.
#define HOME_LAT 40.2859f
#define HOME_LON -76.6502f

// --- OpenSky API (we'll fill these in later) ---
